# setup.ps1 creates .env automatically with a random local database password.
V2_DB_PORT=55432
V2_API_PORT=8012
V2_DB_PASSWORD=replace_with_a_local_password
V2_DATABASE_URL=postgresql://trader:replace_with_a_local_password@127.0.0.1:55432/trader_v2
# Optional stage-two settings; these defaults also work without adding them to .env.
V2_MODEL_PATH=D:/dongkw/v2/.runtime/models/bge-small-zh-v1.5
V2_EMBEDDING_THREADS=4
V2_RETRIEVAL_MIN_SCORE=0.55
